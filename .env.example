# =============================================================================
# SynchroAPI: Meta Global AI Developer Hackathon Environment Configuration
# =============================================================================
# Note: When these variables are omitted or set to "mock-key", SynchroAPI
# automatically runs in Deterministic Offline Simulation Mode for reproducible
# CI/CD verification and live Rich TUI demos.

# 1. Meta Muse Spark Open (Baseten 2M TPM Endpoint) - Manager & Semantic Critic
BASETEN_API_KEY=mock-key
BASETEN_BASE_URL=https://bridge.baseten.co/v1/direct
MUSE_SPARK_MODEL_ID=meta-llama/Muse-Spark-Open-70B

# 2. Meta Muse Code (Fireworks AI Speculative Decoding) - Surgical AST Executor
FIREWORKS_API_KEY=mock-key
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
MUSE_CODE_MODEL_ID=accounts/fireworks/models/muse-code-34b-instruct

# 3. GitHub App / PAT & Webhook Security
GITHUB_TOKEN=mock-token
GITHUB_WEBHOOK_SECRET=synchro-webhook-secret

# 4. Simulation Override ("1" forces offline deterministic mode even if keys exist)
SYNCHRO_FORCE_SIMULATION=0
